# INFRASTRUCTURE / MONGO
# Production image coordinates. Use an immutable release tag when deploying.
MAMMI_IMAGE_PREFIX=mammi
MAMMI_IMAGE_TAG=1.0
# MONGO
MONGO_ROOT_USERNAME=mammi
MONGO_ROOT_PASSWORD=replace-with-a-long-random-password
# Keep this file outside version control. It must already exist on the host.
MONGO_REPLICA_KEYFILE=./secrets/mongo-keyfile

# BACKEND
ACCESS_TOKEN_PRIVATE_KEY=replace-with-a-long-random-access-secret
REFRESH_TOKEN_PRIVATE_KEY=replace-with-a-long-random-refresh-secret
PUBLIC_ORDER_REALTIME_PRIVATE_KEY=replace-with-a-long-random-secret
TURNSTILE_SECRET_KEY=replace-with-cloudflare-turnstile-secret-key
DEFAULT_SUPERADMIN_ACCOUNT=superadmin
DEFAULT_SUPERADMIN_PASSWORD=replace-with-a-strong-password
SALT=10
# Private IP/hostname of the Docker production host. Change this one value for internal access.
MAMMI_PRIVATE_HOST=192.168.1.100
# Public URL configured for the Cloudflare Tunnel.
ORDER_WEB_URL=https://order.mammi.tw
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# FRONTEND
# Public order-web URL used by POS to generate table QR codes and online-order links.
# This must be the Cloudflare public domain, not the Docker hostname.
NEXT_PUBLIC_ORDER_WEB_URL=https://order.mammi.tw
NEXTAUTH_SECRET=replace-with-a-long-random-nextauth-secret
# false: use when the POS frontend is accessed over internal HTTP.
# true: use only when the POS frontend is accessed over HTTPS; otherwise login cookies will not be sent.
NEXTAUTH_USE_SECURE_COOKIES=false

# ORDER-WEB
# Embedded into the order-web image at build time.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-cloudflare-turnstile-site-key

# BACKUP WORKER
BACKUP_ENABLED=false
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
RESTIC_REPOSITORY=s3:https://<cloudflare-account-id>.r2.cloudflarestorage.com/<bucket-name>/mammi
RESTIC_PASSWORD=replace-with-a-long-unique-backup-password
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
BACKUP_POLL_INTERVAL_SECONDS=60
BACKUP_RETRY_DELAY_SECONDS=300
BACKUP_MAX_ATTEMPTS=5

# CLOUDFLARE
# Token of the Cloudflare Zero Trust tunnel used by cloudflared.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
