# Copy this file to .env, then replace every value before running Docker Compose.
MONGO_ROOT_USERNAME=mammi
MONGO_ROOT_PASSWORD=replace-with-a-long-random-password
ACCESS_TOKEN_PRIVATE_KEY=replace-with-a-long-random-access-secret
REFRESH_TOKEN_PRIVATE_KEY=replace-with-a-long-random-refresh-secret
DEFAULT_EMPLOYEE_ACCOUNT=employee
DEFAULT_EMPLOYEE_PASSWORD=replace-with-a-strong-password
DEFAULT_ADMIN_ACCOUNT=admin
DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-password
DEFAULT_SUPERADMIN_ACCOUNT=superadmin
DEFAULT_SUPERADMIN_PASSWORD=replace-with-a-strong-password
PRINT_AGENT_TOKEN=replace-with-a-long-random-print-agent-token
NEXTAUTH_SECRET=replace-with-a-long-random-nextauth-secret
NEXT_PUBLIC_PRINT_AGENT_ENABLED=false
